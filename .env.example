# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/vandi_users

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Phones that get the admin role when they log in (comma-separated)
ADMIN_PHONES=+919999999999

# console = OTP printed in the server log and returned as dev_code (development only)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# local = ./uploads, s3 = private S3 bucket (recommended in production)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=
AWS_REGION=ap-south-1
MAX_UPLOAD_MB=5

# Bump when the driver privacy notice text changes; drivers must accept again
CONSENT_VERSION=2026-10-v1
# Bump when the customer booking & cancellation policy text changes; customers accept again
CUSTOMER_POLICY_VERSION=2026-10-v1

# Web admin + Expo dev server origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Licence OCR on the server: none (the website/app reads the photo) or textract (AWS Textract, paid)
OCR_PROVIDER=none

# Shared secret the order-service sends to call /internal/* (same value in both services' .env)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=dev-service-token-change-me-0123456789abcdef
